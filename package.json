{
  "name": "dq-daily-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:visual": "vite build --mode visual",
    "check:no-fixtures": "node scripts/assert-no-fixtures.mjs dist",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.js,.svelte",
    "lint:fix": "eslint . --ext .ts,.js,.svelte --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual:fonts": "node scripts/copy-visual-fonts.mjs",
    "test:visual:prototypes": "node scripts/serve-prototypes.mjs --port 4174",
    "test:visual:fixtures": "node scripts/dump-fixtures.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:ui-css": "node scripts/check-ui-css.mjs",
    "pretest:visual": "npm run test:visual:fonts",
    "test:visual": "playwright test",
    "test:visual:page": "node tests/visual/run-suite.mjs page",
    "test:visual:quick": "node tests/visual/run-suite.mjs quick",
    "test:visual:update": "npm run test:visual:fonts && npm run test:visual:fixtures",
    "check:prototype-shared": "node scripts/check-prototype-shared.mjs",
    "check:ci-coverage": "node scripts/check-ci-coverage.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
